# Model access — required for the agent layer (Phase 5+). Not needed for
# the engine, ingest, query, or retrieval packages.
ANTHROPIC_API_WORKSPACE=
ANTHROPIC_API_KEY=

# Models are chosen per role, not globally (D15). The agent is given very
# little to do -- ADR-001 puts the reasoning in the engine -- so routing and
# provision-name selection run on the small tier and only the answer uses the
# mid tier. Leave these unset to take those defaults.
#
#   ANTHROPIC_MODEL_ROUTER=claude-haiku-4-5-20251001
#   ANTHROPIC_MODEL_INTENT=claude-haiku-4-5-20251001
#   ANTHROPIC_MODEL_ANSWER=claude-sonnet-5
#
# Setting ANTHROPIC_MODEL pins every role to one model, which is what an eval
# run does when comparing tiers. Left commented out so the defaults apply:
# the previous value here was claude-opus-5, the most expensive tier, and also
# not a current model id.
# ANTHROPIC_MODEL=claude-sonnet-5

# Build artifacts the API opens read-only (ADR-004). Build them with
#   uv run python -m nbadata.ingest.load --out build/nbacba.db
#   uv run python -m rag --out build/cba-index.db
# (Replaces DATABASE_URL and RAG_INDEX_DIR, which nothing ever read.)
NBACBA_LEAGUE_DB=build/nbacba.db
NBACBA_CBA_INDEX=build/cba-index.db

# The web app's origin(s), comma-separated. Unset in development means
# http://localhost:3000; unset anywhere else means no browser may call the API.
# NBACBA_ALLOWED_ORIGINS=http://localhost:3000
NBACBA_ENVIRONMENT=development

# The web app (apps/web) reads this at build time. Defaults to the local API.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Tracing — Langfuse Cloud Hobby, one trace per user session (D4, D16).
# Free: 50,000 units/month, 30 days retention. Keys come from the Langfuse
# project settings page. Absent these, the agent still runs and still builds
# every trace; it just writes them locally instead of sending them.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# The local exporter, which needs no account and no network. Not a fallback:
# it is the copy that survives Langfuse's 30-day retention window, and the
# source of the committed exemplars in docs/traces/ (task 6.10a).
TRACE_ENABLED=true
TRACE_EXPORT_DIR=./traces

# Raindrop is no longer used (superseded by D16). RAINDROP_API_KEY can go.
