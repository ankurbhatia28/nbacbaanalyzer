# Model access — required for the agent layer (Phase 5+). Not needed for
# the engine, ingest, query, or retrieval packages.
ANTHROPIC_API_WORKSPACE=
ANTHROPIC_API_KEY=

# Pin the model in config rather than in code; every call routes through
# packages/.../llm client so this is a one-file change.
ANTHROPIC_MODEL=claude-opus-5

# Local paths — nothing here is a hosted service (ADR: local-first, minimal cost)
DATABASE_URL=sqlite:///./nbacba.db
RAG_INDEX_DIR=./packages/rag/index

# Tracing — Raindrop, one trace per user session (D4, build-plan task 6.10)
TRACE_ENABLED=true
TRACE_EXPORT_DIR=./traces
